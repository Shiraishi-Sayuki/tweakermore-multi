{
  "schemaVersion": 1,
  "id": "tweakermore",
  "version": "${mod_version}",

  "name": "TweakerMore",
  "description": "A collection of client-side tweak kits for enhance your Minecraft game experience",
  "authors": [
    "Fallen_Breath"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/tweakermore",
    "sources": "https://github.com/Fallen-Breath/tweakermore"
  },
  "license": "LGPL-3.0",

  "icon": "assets/tweakermore/icon.png",

  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.sayuki.tweakermore.fabric.TweakerMorePreLaunch"
    ],
    "client": [
      "com.sayuki.tweakermore.fabric.TweakerMoreFabric"
    ],
    "modmenu": [
      "com.sayuki.tweakermore.fabric.ModMenuImpl"
    ]
  },
  "accessWidener": "tweakermore.accesswidener",
  "mixins": [
    "tweakermore.mixins.json"
  ],

  "breaks": {
    "litematica": "<0.19.51",
    "minihud": "<0.32.56",
    "tweakeroo": "<0.21.56"
  },
  "depends": {
    "fabricloader": ">=0.11.4",
    "minecraft": ">=1.21 <=1.21.1",
    "malilib": ">=0.21.10",
    "conditional-mixin": ">=0.2.0",
    "mixinextras": ">=0.3.0"
  }
}
